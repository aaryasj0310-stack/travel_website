# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave DB_PASSWORD blank if your local root user has no password
DB_PASSWORD=
DB_NAME=travel_planner

# Session Security
# Generate a strong, random string for production
SESSION_SECRET=change_this_session_secret
SESSION_NAME=travel_planner_sid
# 24 hours in milliseconds
SESSION_MAX_AGE_MS=86400000

# Security (CORS)
# Set to your exact frontend domain in production (e.g., https://voyage-app.vercel.app)
CORS_ORIGIN=http://localhost:3000
